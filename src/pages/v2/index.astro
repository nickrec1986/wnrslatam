---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import '../../styles/v2.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const phone = '+52 55 5351 1693';
const tel = 'tel:+525553511693';
const wa = 'https://wa.me/525553511693';
const logos = [
  ['aeromexicocargo.png', 'Aeroméxico Cargo'],
  ['bp.png', 'BP'],
  ['carnival.png', 'Carnival'],
  ['cemex.png', 'Cemex'],
  ['dhl.png', 'DHL'],
  ['hilton.png', 'Hilton'],
  ['logopaypal.png', 'PayPal'],
  ['p_e_g.png', 'P&G'],
];
const stats = [
  ['#1', 'Agencia para clientes Fortune 500'],
  ['50+', 'Años de rendimiento comprobado'],
  ['30+', 'Países atendidos'],
  ['20+', 'Idiomas cubiertos'],
  ['300K+', 'Interacciones mensuales'],
  ['99.99%', 'Tiempo de actividad'],
];
const cards = [
  ['Sin cobro, no hay pago', 'Pagas un porcentaje de lo que efectivamente recuperamos.'],
  ['Resultados en días', 'En promedio, el dinero empieza a entrar en 15 días.'],
  ['Monitoreo 24/7', 'Sigues el avance en línea, todo el día.'],
  ['Cerca de tus deudores', '8 hubs cubren México, las Américas y Europa.'],
  ['73% de éxito', 'Tasa de éxito en recuperación.'],
  ['Tu marca, nuestro equipo', 'Especialistas que actúan como extensión de tu marca.'],
];
const steps = [
  ['Pide tu análisis', 'Cuéntanos tu empresa, tu país y el tamaño de la cartera. Es gratuito.'],
  ['Armamos la estrategia', 'El equipo se alinea a tu marca, con más de 50 años de práctica.'],
  ['Empiezas a recuperar', 'Ves los primeros resultados en 15 días, en promedio.'],
];
const services = [
  ['Administrativa', 'Facturas vencidas, gestionadas de forma directa.'],
  ['Especializada', 'Equipos según tu sector y el tipo de deuda.'],
  ['Extrajudicial', 'Negociación antes de una vía legal.'],
  ['Investigación', 'Localizamos al deudor y su capacidad de pago.'],
  ['Judicial', 'Cuando el expediente necesita una vía legal.'],
];
const industries = ['PyMEs', 'Multinacionales', 'Gobierno', 'Retail', 'Servicios financieros'];
const faqs = [
  ['¿Cómo funciona “sin cobro, no hay pago”?', 'Si no recuperamos, no pagas el servicio.'],
  ['¿Cuánto tardas en ver resultados?', 'En promedio, dentro de los primeros 15 días.'],
  ['¿Con qué empresas trabajan?', 'Desde PyMEs hasta multinacionales Fortune 500.'],
  ['¿Cuidan la relación con mis clientes?', 'El trato se mantiene profesional, como extensión de tu marca.'],
];
const odds = [
  ['57%', 'Después de 90 días'],
  ['29%', 'Después de 6 meses'],
  ['13%', 'Después de 1 año'],
];
---

<Base
  title="WNRS – Recupera tu cartera | Análisis gratuito"
  description="Recupera 3 veces más deudas, 10 veces más rápido. Análisis gratuito. Sin cobro, no hay pago."
  path="v2/"
  robots="noindex,follow"
  image="img/wnrs-video-poster.jpg"
>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href={`${base}v2/`} aria-label="WNRS">
        <img src={`${base}img/logo-1.png`} width="150" height="48" alt="WNRS" />
      </a>
      <div class="top-actions">
        <a class="quiet" href={wa} target="_blank" rel="noopener">WhatsApp</a>
        <a class="quiet" href={tel}>{phone}</a>
        <a class="btn" href="#formulario">Quiero mi análisis</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero-band">
      <div class="wrap hero">
        <div class="hero-copy">
          <p class="kicker">Cobranza B2B</p>
          <h1>Recupera tu cartera vencida</h1>
          <p class="lede">3 veces más deudas. 10 veces más rápido que un equipo interno. Más de 50 años y 1,200 profesionales.</p>
          <ul class="ticks">
            <li>¿Tus clientes están atrasados?</li>
            <li>¿Se niegan a pagar?</li>
            <li>¿Tu cartera vencida creció?</li>
          </ul>
          <HeroVideo />
        </div>
        <div class="card" id="formulario">
          <h2>Pide tu análisis gratuito</h2>
          <LeadForm id="lead-v2" submit="Quiero mi análisis" />
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Hechos, no promesas</h2>
        <div class="stats">
          {stats.map(([value, label]) => (
            <div class="stat"><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-paper">
      <div class="wrap">
        <h2>Por qué las empresas eligen WNRS</h2>
        <div class="cards">
          {cards.map(([title, copy]) => (
            <article>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
        <p style="margin-top:1rem;"><a class="btn" href="#formulario">Empieza hoy</a></p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Cómo funciona</h2>
        <div class="steps">
          {steps.map(([title, copy], index) => (
            <article>
              <span class="step-no">{index + 1}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-paper">
      <div class="wrap">
        <h2>Cinco formas de cobrar</h2>
        <div class="services">
          {services.map(([title, copy]) => (
            <article>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
        <h2 style="margin-top:1.6rem;">Tu sector</h2>
        <p>Desde PyMEs hasta multinacionales Fortune 500.</p>
        <div class="chips">
          {industries.map((name) => <span>{name}</span>)}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Líderes financieros confían en WNRS</h2>
        <ul class="logos">
          {logos.map(([file, name]) => (
            <li><img src={`${base}img/${file}`} alt={name} /></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band band-paper">
      <div class="wrap proof">
        <blockquote class="quote">
          <p>“Nuestra cartera morosa había crecido de forma descontrolada desde que subió el precio del dólar estadounidense. WNRS cobró durante un mes lo que mi equipo no pudo recuperar en un año.”</p>
          <footer>Emilio Miranda, Microtech S.A. de C.V.</footer>
        </blockquote>
        <div class="mini">
          <div><strong>44.2%</strong><span> Aumento en las cobranzas</span></div>
          <div><strong>$28 millones</strong><span> Cobrados</span></div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>El tiempo baja lo que puedes cobrar</h2>
        <p>Tu probabilidad de recuperación cae si esperas.</p>
        <div class="odds">
          {odds.map(([value, label]) => (
            <div><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
        <p style="margin-top:1rem;"><a class="btn" href="#cierre">Recupera ahora, antes de que sea tarde</a></p>
      </div>
    </section>

    <section class="band band-paper faq">
      <div class="wrap">
        <h2>Preguntas frecuentes</h2>
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="band" id="cierre">
      <div class="wrap final">
        <div>
          <h2>Tu análisis es gratuito</h2>
          <p>Si no recuperamos, no pagas. Llámanos o escríbenos.</p>
          <p><a href={tel}>{phone}</a> · <a href={wa}>WhatsApp</a></p>
        </div>
        <div class="card">
          <h2>Empieza ya</h2>
          <LeadForm id="lead-v2-cierre" submit="Empieza ya" />
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <div>
        <h2>Servicios</h2>
        <ul>
          <li>Cobranza administrativa</li>
          <li>Cobranza especializada</li>
          <li>Cobranza extrajudicial</li>
          <li>Investigación financiera</li>
          <li>Cobranza judicial</li>
        </ul>
      </div>
      <div>
        <h2>Contacto</h2>
        <ul>
          <li>México, Américas, Europa</li>
          <li><a href={tel}>{phone}</a></li>
          <li><a href={wa}>WhatsApp</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap legal">©2026 WNRS — World Net Recovery Systems.</div>
  </footer>

  <div class="dock">
    <a href={wa} target="_blank" rel="noopener">WhatsApp</a>
    <a href={tel}>Llamar</a>
    <a class="btn" href="#formulario">Cotizar</a>
  </div>
</Base>
