---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import LeadForm from '../components/LeadForm.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pageUrl = new URL(base, Astro.site).href;
const logo = new URL(`${base}img/logo-1.png`, Astro.site).href;

const logos = [
  ['aeromexicocargo.png', 'Aeroméxico Cargo'],
  ['bp.png', 'BP'],
  ['carnival.png', 'Carnival'],
  ['cemex.png', 'Cemex'],
  ['dhl.png', 'DHL'],
  ['hilton.png', 'Hilton'],
  ['logopaypal.png', 'PayPal'],
  ['p_e_g.png', 'P&G'],
];
const pains = [
  '¿Tus clientes están atrasados con los pagos?',
  '¿Se están negando a pagar?',
  '¿Tu cartera vencida creció?',
];
const steps = [
  ['Pide tu análisis', 'Cuéntanos tu empresa, tu país y cómo está tu cartera. El análisis es gratuito.'],
  ['Armamos la estrategia', 'Un equipo especializado trabaja como extensión de tu marca, con más de 50 años de práctica.'],
  ['Empiezas a recuperar', 'En promedio ves los primeros resultados en 15 días, con monitoreo en línea 24/7. Ocho hubs cubren México, las Américas y Europa.'],
];
const services = [
  ['Cobranza administrativa', 'Gestión directa de las facturas vencidas.'],
  ['Cobranza especializada', 'Equipos según tu sector y el tipo de deuda.'],
  ['Cobranza extrajudicial', 'Negociación antes de una vía legal.'],
  ['Investigación financiera', 'Localización del deudor y de su capacidad de pago.'],
  ['Cobranza judicial', 'Cuando el expediente necesita una vía legal.'],
];
const industries = ['PyMEs', 'Multinacionales', 'Gobierno', 'Retail', 'Servicios financieros'];
const stats = [
  ['#1', 'Agencia para clientes Fortune 500'],
  ['50+', 'Años de rendimiento comprobado'],
  ['30+', 'Países atendidos'],
  ['20+', 'Idiomas cubiertos'],
  ['300K+', 'Interacciones mensuales'],
  ['99.99%', 'Tiempo de actividad'],
];
const benefits = [
  'Sin cobro = sin pago',
  'Precios más competitivos del mercado',
  'Monitoreo 24/7 en línea',
  'Resultados en 15 días, en promedio',
  'Talento incomparable',
];
const faqs = [
  ['¿Cómo funciona el modelo “sin cobro, no hay pago”?', 'Cobramos un porcentaje de lo que efectivamente recuperamos. Si no recuperamos, no pagas el servicio.'],
  ['¿Cuánto tardas en ver los primeros resultados?', 'En promedio, dentro de los primeros 15 días empieza a entrar el dinero recuperado.'],
  ['¿Cobran solo a empresas?', 'No. Es cobranza B2B y B2C: carteras de empresas y de consumidores, desde PyMEs hasta multinacionales Fortune 500. El equipo se arma según tu cartera.'],
  ['¿Cómo cuidan la relación con mis clientes?', 'Los especialistas actúan como extensión de tu marca y mantienen el trato profesional.'],
];
const odds = [
  ['57%', 'Después de 90 días'],
  ['29%', 'Después de 6 meses'],
  ['13%', 'Después de 1 año'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'WNRS',
      legalName: 'World Net Recovery Systems',
      url: pageUrl,
      logo,
      telephone: '+52-55-5351-1693',
      areaServed: ['México', 'Américas', 'Europa'],
      description: 'Especialistas en cobranza B2B y B2C. WNRS te ayuda a recuperar tu cartera vencida.',
    },
    {
      '@type': 'WebPage',
      name: 'WNRS — Recupera tu cartera vencida | Cobranza B2B y B2C',
      url: pageUrl,
      inLanguage: 'es',
      description: 'Cobranza B2B y B2C. las empresas que usan nuestros servicios recuperan 3 veces o más, hasta 10x más rápido que las agencias convencionales, sin sacrificar la experiencia del cliente.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base
  title="WNRS — Recupera tu cartera vencida | Cobranza B2B y B2C"
  description="Cobranza B2B y B2C. las empresas que usan nuestros servicios recuperan 3 veces o más, hasta 10x más rápido que las agencias convencionales, sin sacrificar la experiencia del cliente."
  jsonLd={jsonLd}
>
  <Chrome>
    <main>
      <section class="hero" id="solicite">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker">Cobranza B2B y B2C</p>
            <h1>Recupera tu cartera vencida y transfórmala en flujo de efectivo</h1>
            <p class="lede">
              Con más de 50 años de experiencia y más de 1,200 profesionales, las empresas que usan nuestros servicios recuperan 3 veces o más, hasta 10x más rápido que las agencias convencionales, sin sacrificar la experiencia del cliente.
            </p>
            <a class="btn" href="#formulario">Recupera tus deudas ahora</a>
          </div>
          <div class="card" id="formulario">
            <h2>Solicita tu análisis gratuito</h2>
            <LeadForm id="lead-hero" submit="Solicitar análisis gratuito" />
          </div>
        </div>
      </section>

      <section class="logo-bar" aria-label="Empresas que confían en WNRS">
        <div class="wrap">
          <h2>Líderes financieros de empresas globales y regionales confían en WNRS</h2>
          <ul class="logos">
            {logos.map(([file, name]) => (
              <li><img src={`${base}img/${file}`} alt={name} /></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <h2>Cuando la cartera deja de entrar</h2>
          <div class="pains">
            {pains.map((pain) => (
              <article><h3>{pain}</h3></article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="wrap split">
          <div>
            <h2>Cómo funciona</h2>
            <div class="steps">
              {steps.map(([title, copy], index) => (
                <article>
                  <span class="step-no">{index + 1}</span>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </article>
              ))}
            </div>
          </div>
          <img class="photo" src={`${base}img/ft03.jpg`} alt="Equipo de WNRS en una reunión de trabajo" width="1000" height="678" />
        </div>
      </section>

      <section class="section" id="servicios">
        <div class="wrap">
          <div class="split">
            <div>
              <h2>Servicios de cobranza a tu medida</h2>
              <p>Cinco líneas para recuperar la cartera, de la gestión de facturas a la vía legal.</p>
            </div>
            <img class="photo" src={`${base}img/ft09.jpg`} alt="Conversación sobre una cartera vencida" width="1000" height="667" />
          </div>
          <div class="services">
            {services.map(([title, copy]) => (
              <article>
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="wrap">
          <h2>Sectores</h2>
          <p>Cobranza B2B y B2C, desde PyMEs hasta multinacionales Fortune 500.</p>
          <ul class="industries">
            {industries.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <h2>Nuestros clientes recuperan 3 veces o más — 10 veces más rápido.</h2>
          <div class="stats">
            {stats.map(([value, label]) => (
              <div class="stat"><strong>{value}</strong><span>{label}</span></div>
            ))}
            <div class="stat"><strong>44.2%</strong><span>Aumento en las cobranzas</span></div>
            <div class="stat"><strong>$28 millones</strong><span>Cobrados</span></div>
          </div>
          <div class="split" style="margin-top: 1rem;">
            <blockquote class="quote">
              <p>“Nuestra cartera morosa había crecido de forma descontrolada desde que subió el precio del dólar estadounidense. WNRS cobró durante un mes lo que mi equipo no pudo recuperar en un año.”</p>
              <footer>Emilio Miranda, Microtech S.A. de C.V.</footer>
            </blockquote>
            <img class="photo" src={`${base}img/ft05.jpg`} alt="Especialista de WNRS revisa una cartera" width="1000" height="665" />
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="wrap benefits">
          <div>
            <h2>Sin cobro, no hay pago</h2>
            <ul>
              {benefits.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="success">
            <strong>73%</strong>
            <span>Tasa de éxito en recuperación</span>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas">
        <div class="wrap">
          <h2>Preguntas frecuentes</h2>
          {faqs.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section urgency">
        <div class="wrap">
          <h2>No esperes más. El tiempo está en tu contra</h2>
          <p>El castigo contable no recupera el dinero. Tu probabilidad de cobro baja con el tiempo.</p>
          <div class="urgency-grid">
            {odds.map(([value, label]) => (
              <div><strong>{value}</strong><span>{label}</span></div>
            ))}
          </div>
          <p style="margin-top: 1rem;"><a class="btn btn-white" href="#cierre">Recupera ahora, antes de que sea tarde</a></p>
        </div>
      </section>

      <section class="section final" id="cierre">
        <div class="wrap final-grid">
          <div>
            <h2>Recupera tu flujo de efectivo</h2>
            <p>Pide el análisis gratuito hoy. Si no recuperamos, no pagas.</p>
            <p><a href="tel:+525553511693">+52 55 5351 1693</a> · <a href="https://wa.me/525553511693">WhatsApp</a></p>
          </div>
          <div class="card">
            <h2>Empieza ya</h2>
            <LeadForm id="lead-cierre" submit="Empieza ya" />
          </div>
        </div>
      </section>
    </main>
  </Chrome>
</Base>
