---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const videoId = 'SZ60B4-5dPI';
---

<div class="player" data-yt={videoId}>
  <img
    class="player-poster"
    src={`${base}img/wnrs-video-poster.jpg`}
    width="1280"
    height="720"
    alt="David Fridman presenta WNRS"
    loading="lazy"
  />
  <button class="player-sound" type="button" hidden>Activar sonido</button>
  <div class="player-mount"></div>
  <noscript>
    <a href={`https://www.youtube.com/watch?v=${videoId}`}>Ver el video de WNRS</a>
  </noscript>
</div>

<script>
  declare global {
    interface Window {
      YT: {
        Player: new (el: HTMLElement, options: Record<string, unknown>) => {
          unMute: () => void;
          setVolume: (volume: number) => void;
          playVideo: () => void;
        };
      };
      onYouTubeIframeAPIReady?: () => void;
    }
  }

  const nodes = document.querySelectorAll<HTMLElement>('[data-yt]');

  function ensureApi() {
    if (window.YT?.Player) return Promise.resolve();
    return new Promise<void>((resolve) => {
      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        previous?.();
        resolve();
      };
      if (!document.querySelector('script[data-yt-api]')) {
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        script.dataset.ytApi = '1';
        document.head.appendChild(script);
      }
    });
  }

  async function boot(root: HTMLElement, muted: boolean) {
    if (root.dataset.booted === '1') return;
    root.dataset.booted = '1';
    const videoId = root.dataset.yt;
    const mount = root.querySelector('.player-mount');
    const poster = root.querySelector('.player-poster');
    const sound = root.querySelector('.player-sound');
    if (!videoId || !(mount instanceof HTMLElement)) return;
    await ensureApi();
    const player = new window.YT.Player(mount, {
      videoId,
      width: '100%',
      height: '100%',
      playerVars: {
        autoplay: 1,
        mute: muted ? 1 : 0,
        playsinline: 1,
        rel: 0,
        modestbranding: 1,
        origin: window.location.origin,
      },
      events: {
        onReady: (event) => {
          event.target.playVideo();
          if (poster instanceof HTMLElement) poster.hidden = true;
          if (sound instanceof HTMLButtonElement) {
            sound.hidden = false;
            if (!muted) {
              sound.textContent = 'Sonido activo';
              sound.disabled = true;
            }
          }
        },
      },
    });
    sound?.addEventListener('click', () => {
      player.unMute();
      player.setVolume(80);
      if (sound instanceof HTMLButtonElement) {
        sound.textContent = 'Sonido activo';
        sound.disabled = true;
      }
    });
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  nodes.forEach((root) => {
    if (reduced) {
      root.addEventListener('click', () => boot(root, false), { once: true });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          boot(root, true);
        }
      },
      { rootMargin: '200px' },
    );
    observer.observe(root);
  });
</script>
